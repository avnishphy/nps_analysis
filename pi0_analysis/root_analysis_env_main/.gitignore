# Runtime campaign products. These directories are regenerated by documented
# launchers and are not source, configuration, or calibration inputs.
/output/
/output_*/
/logs/
/scratch/
/build/
/recovery/

# ROOT/ACLiC products generated beside their source by compilation.
/src/analysis/*_C.so
/src/analysis/*_C.d
/src/analysis/*_C_ACLiC_dict_rdict.pcm
/src/analysis/*_cpp.so
/src/analysis/*_cpp.d
/src/analysis/*_cpp_ACLiC_dict_rdict.pcm
/src/simulation_smearing/*_C.so
/src/simulation_smearing/*_C.d
/src/simulation_smearing/*_C_ACLiC_dict_rdict.pcm

# Rebuildable native executables; retain and version their source files.
/src/efficiencies/compute_efficiencies_stuff
/src/efficiencies/compare_livetimes

# Interpreter/editor caches.
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/

# Generated batch manifest from the smearing submitter.
/smearing_job_manifest.txt

# Generated LaTeX build directories in the retained efficiency evidence tree.
/src/efficiencies/misc/livetime_beamer_20260909/build/
/src/efficiencies/misc/livetime_complete_20260910/build/
/src/efficiencies/misc/livetime_complete_20260910/evidence/historical_beamer/build/

# Large raw column caches are reproducible from the adjacent scripts/manifests.
# Keep the CSV/JSON/text evidence in these trees visible to Git.
/src/efficiencies/misc/livetime_refresh_20260909/raw4305/**/*.bin
/src/efficiencies/misc/livetime_complete_20260910/evidence/full_cache/raw4305/**/*.bin

# Parent rules ignore ROOT/PNG files by extension. These exact small files are
# inputs or curated website evidence and therefore belong in the checkpoint.
!/config/pid_cuts.root
!/config/pid_cuts_x60_4a.root
!/misc/html/assets/img/*.png
